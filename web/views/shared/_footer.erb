<% footer_static_pages = defined?(static_pages) && static_pages ? static_pages : []
   footer_view_mode = defined?(current_view_mode) && current_view_mode ? current_view_mode.to_s : "" %>
<footer class="app-footer">
  <%# Join strip (SPEC UX12; audit follow-up 04): the radio settings a newcomer
      needs, moved here from the meta row. The old `details` link is dropped —
      the About link in the footer links row below sits right beside it. The
      MeshCore entry appears only when both preset values are configured. %>
  <div class="join-line footer-join">
    <span class="join-line__entry"><span class="join-line__proto">Meshtastic</span> · <%= Rack::Utils.escape_html(sanitized_channel) %> · <%= Rack::Utils.escape_html(sanitized_frequency) %></span>
    <% if sanitized_meshcore_preset && sanitized_meshcore_freq %>
      <span class="join-line__separator" aria-hidden="true">—</span>
      <span class="join-line__entry"><span class="join-line__proto">MeshCore</span> · <%= Rack::Utils.escape_html(sanitized_meshcore_preset) %> · <%= Rack::Utils.escape_html(sanitized_meshcore_freq) %></span>
    <% end %>
  </div>
  <div class="footer-content">
    <span class="footer-brand">PotatoMesh</span>
    <% if version && !version.empty? %>
      <span class="footer-separator" aria-hidden="true">·</span>
      <span class="mono"><%= version %></span>
    <% end %>
    <%# The links are their own footer tier (Post-Deploy review 02): flex-basis
        100% drops them to their own line so the row can't strand a separator
        on line one. Dot separators, not em dashes (Post-Deploy review 03). %>
    <span class="footer-links">
      <%# Static operator pages live in the footer tier (SPEC UX11): the
          primary nav carries only the product views. %>
      <% footer_static_pages.each do |sp| %>
        <% sp_active = footer_view_mode == "page_#{sp.slug}" %>
        <a href="/pages/<%= Rack::Utils.escape_path(sp.slug) %>"<%= sp_active ? ' aria-current="page"' : "" %>><%= Rack::Utils.escape_html(sp.title) %></a>
        <span class="footer-separator" aria-hidden="true">·</span>
      <% end %>
      GitHub:
      <a href="https://github.com/l5yth/potato-mesh" target="_blank">l5yth/potato-mesh</a>
      <% if contact_link && !contact_link.empty? %>
        <span class="footer-separator" aria-hidden="true">·</span>
        <span class="footer-contact">
          chat:
          <% if contact_link_url %>
            <a href="<%= contact_link_url %>" target="_blank"><%= contact_link %></a>
          <% else %>
            <%= contact_link %>
          <% end %>
        </span>
      <% end %>
    </span>
  </div>
</footer>
